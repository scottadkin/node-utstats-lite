<%- include("header.ejs", {
    "mode": "match", 
    meta,
    host,
    userSession
    }) %>
<%- include("timeZone.ejs", {timeZone})%>

<%

const jsBase = (seasonId == 0) ? "../js/" : "../../js/";

%>
<script src="<%- jsBase %>ui/ui.js"></script>
<script src="<%- jsBase %>ui/table.js"></script>
<script src="<%- jsBase %>ui/matches.js"></script>

<div id="root"></div>
<script>
    new MatchesSearchForm(
        "<%= seasonId %>",
        <%- JSON.stringify(uniqueCombinations) %>, 
        "<%= selectedServer %>", "<%= selectedGametype %>", "<%= selectedMap %>",
        "<%= displayMode %>",  
        <%- JSON.stringify(matches)%>
    );
</script>

<script>
    const matchData = <%- JSON.stringify(matches)%>;  

    <% if(displayMode !== "default"){ %>
        renderMatchesTable("#root", matchData, false, true);
    <%}else{ %>
        new MatchesRichView("#root", matchData);
    <% }
    %>

    
</script>



<%- include("footer.ejs") -%>