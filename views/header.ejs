        {"name": "CTF League", "url": "/ctfleague", "highlight": ["ctfleague"]},
        {"name": "Records", "url": "/records", "highlight": ["records"]},
        {"name": "Maps", "url": "/maps", "highlight": ["maps"]}
    );
}

if(locals.bSeasonPage){

    if(locals.seasonInfo === undefined) throw new Error(`Season Info is missing`);

    if(locals.seasonInfo !== null){

        const seasonSubURL = `/season/${locals.seasonInfo.id}`;
        options.push({"name": "Season Home", "url": `${seasonSubURL}/`, "highlight": ["season-home"]});
        options.push({"name": "Matches", "url": `${seasonSubURL}/matches`, "highlight": ["matches", "match"]});
        options.push({"name": "Players", "url": `${seasonSubURL}/players`, "highlight": ["players"]});
