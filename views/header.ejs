        options.push({"name": "CTF League", "url": `${seasonSubURL}/ctfleague`, "highlight": ["ctfleague"]});
        options.push({"name": "Records", "url": `${seasonSubURL}/records`, "highlight": ["records"]});
        options.push({"name": "Maps", "url": `${seasonSubURL}/maps`, "highlight": ["maps"]});
    }
}

