<% 

const options = [];

if(locals.bSeasonPage && locals.seasonInfo !== undefined && locals.seasonInfo !== null){
    options.push({"name": "Main Site", "url": "/", "highlight": ["home"]});
}else{
    options.push({"name": "Home", "url": "/", "highlight": ["home"]});
}


options.push({"name": "Seasons", "url": "/seasons", "highlight": ["season", "seasons"]});

if(!locals.bSeasonPage || (locals.seasonInfo === undefined || locals.seasonInfo === null)){
    options.push(
        {"name": "Matches", "url": "/matches", "highlight": ["match"]},
        {"name": "Players", "url": "/players", "highlight": ["player", "players"]},
        {"name": "Rankings", "url": "/rankings", "highlight": ["rankings"]},
        {"name": "CTF League", "url": "/ctfleague", "highlight": ["ctfleague"]},
        {"name": "Records", "url": "/records", "highlight": ["records"]},
        {"name": "Maps", "url": "/maps", "highlight": ["maps"]}
    );
}

if(locals.bSeasonPage){

    if(locals.seasonInfo === undefined) throw new Error(`Season Info is missing`);

    if(locals.seasonInfo !== null){

        const seasonSubURL = `/season/${locals.seasonInfo.id}`;
        options.push({"name": "Season Home", "url": `${seasonSubURL}/`, "highlight": ["season-home"]});
        options.push({"name": "Matches", "url": `${seasonSubURL}/matches`, "highlight": ["matches"]});
        options.push({"name": "Players", "url": `${seasonSubURL}/players`, "highlight": ["players"]});
    }
}

if(userSession === null){
    options.push({"name": "Login", "url": "/login", "highlight": ["login"]});
    options.push({"name": "Register", "url": "/register", "highlight": ["register"]});
}else{
    options.push({"name": "Admin", "url": "/admin", "highlight": ["admin"]},);
    options.push({"name": "Logout", "url": "/logout", "highlight": ["logout"]},);
}

options.push({"name": "Watchlist", "url": "/watchlist", "highlight": ["watchlist"]},);

const DEFAULT_DESC = `Unreal Tournament stats tracking website.`;
