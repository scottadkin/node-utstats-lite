<% 

const options = [];


if(!locals.bSeasonPage || locals.bSkipSeasonLinks){
    options.push({"name": "Home", "url": "/", "highlight": ["home", "season-home"]});
}

if(locals.bSkipSeasonLinks || !locals.bSeasonPage || (locals.seasonInfo === undefined || locals.seasonInfo === null)){
    options.push(
        {"name": "Matches", "url": "/matches", "highlight": ["matches", "match"]},
        {"name": "Players", "url": "/players", "highlight": ["player", "players"]},
        {"name": "Rankings", "url": "/rankings", "highlight": ["rankings"]},
        {"name": "CTF League", "url": "/ctfleague", "highlight": ["ctfleague"]},
        {"name": "Records", "url": "/records", "highlight": ["records"]},
        {"name": "Maps", "url": "/maps", "highlight": ["maps"]}
    );
}

if(locals.bSeasonPage && !locals.bSkipSeasonLinks){

    if(locals.seasonInfo === undefined) throw new Error(`Season Info is missing`);

    if(locals.seasonInfo !== null){

        const seasonSubURL = `/season/${locals.seasonInfo.id}`;
        options.push({"name": "Home", "url": `${seasonSubURL}/`, "highlight": ["season-home"]});
        options.push({"name": "Matches", "url": `${seasonSubURL}/matches`, "highlight": ["matches", "match"]});
        options.push({"name": "Players", "url": `${seasonSubURL}/players`, "highlight": ["players"]});
        options.push({"name": "Rankings", "url": `${seasonSubURL}/rankings`, "highlight": ["rankings"]});
        options.push({"name": "CTF League", "url": `${seasonSubURL}/ctfleague`, "highlight": ["ctfleague"]});
        options.push({"name": "Records", "url": `${seasonSubURL}/records`, "highlight": ["records"]});
        options.push({"name": "Maps", "url": `${seasonSubURL}/maps`, "highlight": ["maps"]});
    }
}

