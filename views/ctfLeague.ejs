
<%- include("header.ejs", {
    "mode": "ctfleague", 
    meta,
    host,
    userSession
    }) -%>
    
<%- include("timeZone.ejs", {timeZone})%>


<script src="/js/ui/table.js"></script>
<script src="/js/ui/ctfLeague.js"></script>


<div id="root">

    <div class="header-wrapper">CTF League</div>
    <div id="tabs"></div>
    <script>
        renderTypeTabs("#tabs", "<%= mode %>", "<%= seasonId %>", <%- locals.bSkipSeasonLinks %>);

        new CTFLeagueFilterForm(
            "#root", 
            "<%= mode %>", 
            <%- JSON.stringify(gametypeNames) %>, 
            <%- JSON.stringify(mapNames) %>, 
            "<%= id %>", 
            "<%= gId %>", 
            "<%= seasonId %>",
            <%- locals.bSkipSeasonLinks %>
        );

        new CTFLeagueInfo(
            "#root",
            "<%= mode %>",       
            <%- maxMatchAge %>,
            <%- maxMatchesPerPlayer %>,
            <%- JSON.stringify(seasonInfo) %>,
            "<%= lastLeagueRefresh %>"
            

        ); 

        new CTFLeagueTable(
            "#root", 
            "<%= mode %>", 
            <%- JSON.stringify(data) %>,  
            "<%= id %>", 
            "<%= gId %>", 
            "<%= page %>", 
            "<%= perPage %>", 
            "<%= subHeader %>", 
            "<%= seasonId %>",
            <%- locals.bSkipSeasonLinks %>
        );
    </script>

</div>

<%- include("footer.ejs") -%>