
<%- include("header.ejs", {
    "mode": "records", 
    meta,
    host,
    userSession
    }) -%>

<%- include("timeZone.ejs", {timeZone})%>
<script src="../js/ui/table.js"></script>
<script src="../js/ui/ui.js"></script>
<script src="../js/ui/records.js"></script>

<div class="header-wrapper">
    Records
</div>

<div id="root">
</div>

<script>

    const validTypes = {
        "player-match": <%- JSON.stringify(validMatchTypes) %>,
        "player-lifetime": <%- JSON.stringify(validLifetimeTypes) %>,
    };

    const gametypes = <%- JSON.stringify(gametypeList) %>;
    const maps = <%- JSON.stringify(mapList) %>;
    const combos = <%- JSON.stringify(gametypeMapCombos) %>;

    new RecordsPage(
        "#root", 
        "<%= mode %>", 
        validTypes, 
        <%- JSON.stringify(MODE_TITLES) %>, 
        gametypes, 
        maps, 
        combos,
        "<%= selectedGametype %>",
        "<%= selectedMap %>"
    );
</script>


<%- include("footer.ejs") -%>