
<%- include("header.ejs", {
    "mode": "records", 
    meta,
    host,
    userSession
    }) -%>

<%- include("timeZone.ejs", {timeZone})%>

<%
const jsBase = `../../js/`
%>
<script src="<%= jsBase %>ui/table.js"></script>
<script src="<%= jsBase %>ui/records.js"></script>


<div id="root">
    <div class="header-wrapper">
        Records
    </div>
</div>

<script>

    const validTypes = {
        "player-match": <%- JSON.stringify(validMatchTypes) %>,
        "player-lifetime": <%- JSON.stringify(validLifetimeTypes) %>,
        "player-epm": <%- JSON.stringify(validEPMTypes) %>,
        "player-avg": <%- JSON.stringify(validAvgTypes) %>,
    };

    const gametypes = <%- JSON.stringify(gametypeList) %>;
    const maps = <%- JSON.stringify(mapList) %>;
    const combos = <%- JSON.stringify(gametypeMapCombos) %>;

    new RecordsPage(
        "<%- siteName %>",
        "#root", 
        "<%= mode %>", 
        validTypes, 
        <%- JSON.stringify(MODE_TITLES) %>, 
        gametypes, 
        maps, 
        combos,
        "<%= selectedGametype %>",
        "<%= selectedMap %>",
        "<%= recordType %>",
        "<%= selectedMinimumMatchesPlayed %>",
        <%- JSON.stringify(data) %>,
        "<%= totalResults %>",
        <%= page %>,
        <%= perPage %>,
        <%- JSON.stringify(ctfGametypes) %>,
        <%- JSON.stringify(ctfMaps) %>,
        <%- JSON.stringify(domGametypes) %>,
        <%- JSON.stringify(domMaps) %>,
        "<%= seasonId %>",
        <%- JSON.stringify(seasonInfo) %>,
        <%= locals.bSkipSeasonLinks %>
    );
</script>


<%- include("footer.ejs") -%>