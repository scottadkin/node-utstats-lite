<%- include(
    "header.ejs", {
        "host":  req.headers.host,
        timeZone,
        title,
        meta,
        userSession,
        "mode": "season-home",
        "bSeasonPage": true,
        "seasonInfo": basicSeasonInfo
    });
-%>
<%- include("timeZone.ejs", {timeZone})%>

<script src="/js/matchScreenshot.js"></script>
<script src="/js/ui/table.js"></script>
<script src="/js/ui/matches.js"></script>
<script src="/js/ui/seasons.js"></script>
<script src="/js/ui/new-canvas-graphs.js"></script>


<div id="root">
   
</div>

<script>

    const messages = {
        "account-created": {
            "content": `Your account has been created, you have to wait for an admin to activate your account before you can login.`,
            "type": "pass"
        },
        "banned": {
            "content": `You have been banned from login attempts due to too many failed login attempts, please try again later.`,
            "type": "error"
        },
        "already": {
            "content": `You are already logged in.`,
            "type": "error"
        },
        "login": {
            "content": `You have logged in successfully`,
            "type": "pass"
        },
        "logout": {
            "content": `You have successfully logged out`,
            "type": "pass"
        },
    };


    const message = "<%= locals.message %>";

    if(message !== "" && messages[message] !== undefined){

        const m = messages[message];

        new UINotification(m.type, "Notice", m.content);
    }


    new SeasonPage(
        <%- JSON.stringify(basicSeasonInfo) %>,
        <%- JSON.stringify(objectStats)%>,
        <%- locals.bSkipSeasonLinks %>,
        <%- JSON.stringify(pageSettings) %>,
        <%- JSON.stringify(pageLayout) %>,
        <%- JSON.stringify(socialSettings) %>,
        <%- JSON.stringify(welcomeMessageSettings) %>,
        <%- JSON.stringify(recentMatches) %>,
        <%- JSON.stringify(mostActivePlayers) %>,
        "<%= pageSettings["Activity Heatmap Default Mode"] %>",
        <%- JSON.stringify(screenshotData)%>
        );
</script>


<%- include("footer.ejs") %>