<%- include("header.ejs", {
        "mode": "maps", 
        meta,
        host,
        userSession,
    });
-%>
<%- include("timeZone.ejs", {timeZone})%>

<%
const jsBase = (seasonId !== 0) ? `../../../js/` : `../js/`;
const jsonBase = (seasonId !== 0) ? `../../../json/` : `../json/`;
%>

<script src="<%= jsBase %>ui/ui.js"></script>
<script src="<%= jsBase %>ui/table.js"></script>
<script src="<%= jsBase %>ui/matches.js"></script>
<script src="<%= jsBase %>ui/maps.js"></script>
<div class="header-wrapper">
    <%= basic.name %>
</div>
<div id="root">
</div>


<script>
    

    const validTypes = <%- JSON.stringify(validTypes) %>;
    const pageSettings = <%- JSON.stringify(pageSettings) %>;
    const ctfLeagueSettings = <%- JSON.stringify(ctfLeagueSettings) %>


    new UIMapPlayerRecords(
                    "#root", 
                    "<%= basic.id %>", 
                    <%- JSON.stringify(uniqueGametypes) %>, 
                    <%- JSON.stringify(validTypes["player-match"]) %>,
                    "<%= seasonId %>"
                );

    <%
    for(let i = 0; i < pageOrder.length; i++){

        const key = pageOrder[i];
        const settingKey = `Display ${key}`;

        if(pageSettings[settingKey] !== 1) continue;

        switch(settingKey){

            case "Display Map Screenshot": {
                %>UIMapImage("#root", <%- JSON.stringify(basic.image) %>, "<%= basic.requiredImageName %>");<%
            } break;

            case "Display Basic Summary":{
                %>UIMapBasicSummary("#root", <%- JSON.stringify(basic) %>);<%
            } break;

            case "Display Weapon Statistics": {
                %>new UIMapWeaponsSummary("#root", <%- JSON.stringify(weaponStats) %>);<%
            } break;

            case "Display Rankings": {
                %>new UIMapPlayerRankings("#root", "<%= basic.id %>");<%
            } break;

            case "Display CTF League": {
                %>new UIMapCTFLeague("#root", "<%= basic.id %>", pageSettings, ctfLeagueSettings);<%
            } break;

            case "Display Recent Matches": {
                %>new UIMapRecentMatches("#root", "<%= basic.id %>", "<%= seasonId %>");<%
            } break;

            case "Display Player Top Averages": {
                %>new UIMapPlayerAverages("#root", "<%= basic.id %>", validTypes, <%- JSON.stringify(uniqueGametypes) %>, "<%= seasonId %>");<%
            }  break;

            case "Display Activity Heatmap": {
                %>new UIMatchesActivtyHeatmap("#root", {
                    "header": "Activity HeatMap", 
                    "gametype": 0,
                    "map": <%= basic.id %>, 
                    "jsonURL": `<%= jsonBase %>activity-heatmap-data/`,
                    "defaultMode": "<%= pageSettings["Activity Heatmap Default Mode"]%>",
                    "seasonId": "<%= seasonId %>"
                }
                );<%
               
            } break;
            case "Display Player Totals": {
                %>new UIMapPlayerTotals(
                    "#root", 
                    "<%= basic.id %>", 
                    <%- JSON.stringify(uniqueGametypes) %>, 
                    <%- JSON.stringify(validTypes["player-lifetime"]) %>,
                    "<%= seasonId %>"
                );<%
            }
        }
    }
    %>
</script>
<%- include("footer.ejs") -%>