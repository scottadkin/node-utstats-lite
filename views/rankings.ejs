
<%- include("header.ejs", {
    "mode": "rankings", 
    meta,
    host,
    userSession
    }) -%>

<%- include("timeZone.ejs", {timeZone})%>

<%
const jsBase = (locals.seasonId !== 0) ? `../../../js/`  : `../js/`;
%>
<script src="<%= jsBase %>ui/ui.js"></script>
<script src="<%= jsBase %>ui/table.js"></script>
<script src="<%= jsBase %>ui/rankings.js"></script>

<div class="header-wrapper">
    <%= (mode === "gametype") ? "Gametype" : "Map" %> Rankings
</div>

<div id="root"></div>
<script>
    new RankingsSearchForm("#root", "<%= mode %>", 
    <%- JSON.stringify(data) %>,
    <%- JSON.stringify(names) %>, 
    "<%= selectedId %>",
    "<%= selectedTimeRange %>",
    "<%= selectedPerPage %>",
    "<%= currentPage %>",
    "<%= seasonId %>"
    );

    new RankingsExplain("#root", <%- JSON.stringify(rankingSettings) %>, "<%= minMatchesSetting %>");
</script>
<%- include("footer.ejs") -%>